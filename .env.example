# Google Drive Configuration
# Google Drive folder ID for Mind Monitor CSV files
# Example: 1Yo4QRa8sP16zRJ9ky-vPHzJ8zEBQ85C5
GDRIVE_FOLDER_ID=your_folder_id_here

# Per-source Google Drive folder IDs used by download_data.sh / upload_to_gdrive.py
GDRIVE_FOLDER_ID_MUSE=your_muse_folder_id_here
GDRIVE_FOLDER_ID_SELFLOOPS=your_selfloops_folder_id_here
# Taps folder is uploaded to via OAuth user auth (service accounts have no storage quota).
# If the folder was created manually in the Drive UI, drive.file scope may reject writes to it;
# run `upload_to_gdrive.py --create-folder <name>` to let the app create an app-owned folder instead.
GDRIVE_FOLDER_ID_TAPS=your_taps_folder_id_here

# Google Drive credentials file path (relative to project root, used by download/rename scripts)
GDRIVE_CREDENTIALS=private/gdrive-creds.json

# OAuth client secrets / token used by upload_to_gdrive.py (defaults to ~/.config/gcp/... if unset)
GDRIVE_OAUTH_CLIENT=/home/you/.config/gcp/oauth-client.json
GDRIVE_OAUTH_TOKEN=/home/you/.config/gcp/tokens/gdrive.json

# Google Sheets Configuration
# Google Spreadsheet ID for session log
# Example: 1S0SwyRbM2cAATv_IOpkOspor-_Ov49rTygyTFr2gkwA
GSHEET_SESSION_LOG_ID=your_spreadsheet_id_here
