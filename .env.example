# Google Drive Configuration
# Google Drive folder ID for Mind Monitor CSV files
# Example: 1Yo4QRa8sP16zRJ9ky-vPHzJ8zEBQ85C5
GDRIVE_FOLDER_ID=your_folder_id_here

# Per-source Google Drive folder IDs used by download_data.sh / upload_to_gdrive.py
GDRIVE_FOLDER_ID_MUSE=your_muse_folder_id_here
GDRIVE_FOLDER_ID_SELFLOOPS=your_selfloops_folder_id_here
# Taps folder needs the service account shared with Editor access (upload requires write access)
GDRIVE_FOLDER_ID_TAPS=your_taps_folder_id_here

# Google Drive credentials file path (relative to project root)
GDRIVE_CREDENTIALS=private/gdrive-creds.json

# Google Sheets Configuration
# Google Spreadsheet ID for session log
# Example: 1S0SwyRbM2cAATv_IOpkOspor-_Ov49rTygyTFr2gkwA
GSHEET_SESSION_LOG_ID=your_spreadsheet_id_here
